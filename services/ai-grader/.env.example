# AI grader microservice config. Copy to .env for local runs.

PORT=4100
NODE_ENV=development

# Shared secret the main API must send as X-Service-Key. Leave empty to disable.
SERVICE_KEY=

# Optional LLM provider (OpenAI-compatible). Leave AI_API_KEY empty to use the
# built-in heuristic grader (no external calls, always works offline).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000
