# Copy to .env and adjust for your environment.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://etest:etest@localhost:5432/etest?schema=public"

# Secret used to sign JWTs. Use a long random value in production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="2h"

# Server
PORT=4000
NODE_ENV=development

# Comma-separated allowed origins for CORS, or "*" for any.
CORS_ORIGIN="http://localhost:5173"

# bcrypt cost factor
BCRYPT_ROUNDS=10

# Logging level: error | warn | info | http | debug
LOG_LEVEL=debug
